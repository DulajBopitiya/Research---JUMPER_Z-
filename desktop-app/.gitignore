# ==========================================
# JP-PLATFORM: PROFESSIONAL GITIGNORE
# ==========================================

# --- 1. Python Environment ---
# We never track the virtual environment; each dev builds their own.
.venv/
venv/
ENV/
env/
bin/
lib/
include/

# --- 2. Compiled Python Files ---
# Junk generated by the Python interpreter.
**/__pycache__/
*.py[cod]
*$py.class
*.so

# --- 3. App Runtime Data ---
# These are generated while you run the app (logs, temp data).
desktop-app/runtime/logs/*.log
desktop-app/runtime/cache/
desktop-app/runtime/user/user_config.json
*.log

# --- 4. Build & Distribution ---
# Artifacts created when you freeze the app into an .exe.
desktop-app/build/
desktop-app/dist/
*.spec

# --- 5. External Tools & Binaries ---
# We track the 'tools' folder structure, but not the .exe files themselves 
# (unless you specifically want to version control the arduino-cli).
desktop-app/tools/*.exe
desktop-app/tools/*.zip
desktop-app/tools/data/
!desktop-app/tools/.gitkeep

# --- 6. Hardware & Project Files ---
# Compiled Arduino/ESP32 binaries (the .bin/.elf files).
desktop-app/projects/**/build/
*.bin
*.elf
*.hex

# --- 7. OS & IDE Specific ---
# User-specific IDE settings (keep it clean for other devs).
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- 8. Exceptions ---
# Ensure we don't accidentally ignore the .gitkeep files we used for structure.
!.gitkeep
