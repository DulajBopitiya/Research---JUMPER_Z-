# ==========================================
# JUMPER-Z: PROFESSIONAL GITIGNORE
# ==========================================

# --- 1. Python Environment ---
# We never track the virtual environment; each dev builds their own.
.venv/
venv/
ENV/
env/
bin/
lib/
include/

# --- 2. Compiled Python Files ---
# Junk generated by the Python interpreter.
**/__pycache__/
*.py[cod]
*$py.class
*.so

# --- 3. Development Runtime Data (IMPORTANT) ---
# We ignore the entire folder we created for development files.
runtime_dev/
# Also ignore general logs in case they leak out
*.log
logs/

# --- 4. User Configs & Local Data ---
# We don't want to track your personal "last project" path or settings.
config/user_config.json
# But we DO want to track the language settings!
!config/language_config.json

# --- 5. Build & Distribution ---
# Artifacts from PyInstaller or other builders
build/
dist/
*.spec

# --- 6. External Tools ---
# We generally don't track large .exe files in Git. 
# Better to let the dev download them or use a setup script.
tools/*.exe
tools/*.zip

# --- 7. Hardware & Project Files ---
# Ignore the temporary "staging" if it's outside runtime_dev
staging/
# Ignore Arduino build artifacts
projects/**/build/
*.bin
*.elf
*.hex

# --- 7. OS & IDE Specific ---
# User-specific IDE settings (keep it clean for other devs).
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- 8. Exceptions ---
# Ensure we don't accidentally ignore the .gitkeep files we used for structure.
!.gitkeep
